# ── Base de données ─────────────────────────────────────────────────────────
# URL de connexion PostgreSQL (Supabase, Neon, Hostinger DB, etc.)
PG_URL=postgresql://user:password@host:5432/dbname

# ── Authentification sessions ────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── SendavaPay (paiements mobiles) ───────────────────────────────────────────
SENDAVAPAY_API_KEY=your_sendavapay_api_key
SENDAVAPAY_WEBHOOK_SECRET=your_sendavapay_webhook_secret

# URL publique de ton site (SANS slash final) — utilisée pour les webhooks SendavaPay
# Exemple : https://monsite.com
WEBHOOK_BASE_URL=https://tondomaine.hostinger.com

# ── Notifications Telegram (optionnel) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Stockage fichiers (optionnel — Google Cloud Storage) ─────────────────────
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
