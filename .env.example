# ─────────────────────────────────────────────────────────────────────────────
# Muzan Service — Environment Variables
# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────

# Port the backend listens on.
# Hostinger Node.js hosting typically assigns port 3000 automatically.
PORT=3000

# Must be "production" in production so the backend serves the frontend.
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Example (Supabase): postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Example (Neon):     postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
PG_URL=postgresql://user:password@host:5432/dbname

# ── CORS (optional) ──────────────────────────────────────────────────────────

# Your production domain. Only needed if external clients (e.g. a mobile app)
# call the API from a different origin. Leave unset for same-origin-only use.
# ALLOWED_ORIGIN=https://www.muzanservice.com

# ── Telegram alerts (optional) ───────────────────────────────────────────────

# Bot token from @BotFather and the chat ID to send alerts to.
# Leave unset to disable Telegram notifications.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100123456789
